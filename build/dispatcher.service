[Unit]
Description=Debuglet Dispatcher Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/debuglet-go
ExecStart=/home/ubuntu/debuglet-go/debuglet-dispatcher -config /home/ubuntu/debuglet-go/local/configs/dispatcher.toml
Restart=on-failure
RestartSec=5s
SyslogIdentifier=debuglet-dispatcher

[Install]
WantedBy=multi-user.target
