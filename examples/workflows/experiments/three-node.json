{
  "version":1,"kind":"experiment","name":"Three-node calculation",
  "participants":[
    {
      "id":"A","label":"Start",
      "workflow":{
        "version":1,"name":"Send a value and await its result","entry":"send",
        "nodes":[
          {"id":"send","block":"send_message","inputs":{"destination":"B","channel":"a_to_b","value":21,"timeout_ms":5000}},
          {"id":"sent","block":"if","inputs":{}},
          {"id":"await","block":"await_message","inputs":{"source":"C","channel":"c_to_a","timeout_ms":8000}},
          {"id":"received","block":"if","inputs":{}},
          {"id":"result","block":"emit","inputs":{"name":"answer"}},
          {"id":"send_error","block":"emit","inputs":{"name":"send_error"}},
          {"id":"receive_error","block":"emit","inputs":{"name":"receive_error"}}
        ],
        "edges":[
          {"kind":"control","from":{"node":"send","port":"next"},"to":{"node":"sent","port":"in"}},
          {"kind":"data","from":{"node":"send","port":"ok"},"to":{"node":"sent","port":"condition"}},
          {"kind":"control","from":{"node":"sent","port":"true"},"to":{"node":"await","port":"in"}},
          {"kind":"control","from":{"node":"sent","port":"false"},"to":{"node":"send_error","port":"in"}},
          {"kind":"data","from":{"node":"send","port":"error"},"to":{"node":"send_error","port":"value"}},
          {"kind":"control","from":{"node":"await","port":"next"},"to":{"node":"received","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"ok"},"to":{"node":"received","port":"condition"}},
          {"kind":"control","from":{"node":"received","port":"true"},"to":{"node":"result","port":"in"}},
          {"kind":"control","from":{"node":"received","port":"false"},"to":{"node":"receive_error","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"value"},"to":{"node":"result","port":"value"}},
          {"kind":"data","from":{"node":"await","port":"error"},"to":{"node":"receive_error","port":"value"}}
        ]
      }
    },
    {
      "id":"B","label":"Double",
      "workflow":{
        "version":1,"name":"Double the value","entry":"await",
        "nodes":[
          {"id":"await","block":"await_message","inputs":{"source":"A","channel":"a_to_b","timeout_ms":8000}},
          {"id":"received","block":"if","inputs":{}},
          {"id":"calculate","block":"multiply","inputs":{"b":2}},
          {"id":"send","block":"send_message","inputs":{"destination":"C","channel":"b_to_c","timeout_ms":5000}},
          {"id":"sent","block":"if","inputs":{}},
          {"id":"result","block":"emit","inputs":{"name":"sent_value"}},
          {"id":"send_error","block":"emit","inputs":{"name":"send_error"}},
          {"id":"receive_error","block":"emit","inputs":{"name":"receive_error"}}
        ],
        "edges":[
          {"kind":"control","from":{"node":"await","port":"next"},"to":{"node":"received","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"ok"},"to":{"node":"received","port":"condition"}},
          {"kind":"control","from":{"node":"received","port":"true"},"to":{"node":"send","port":"in"}},
          {"kind":"control","from":{"node":"received","port":"false"},"to":{"node":"receive_error","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"error"},"to":{"node":"receive_error","port":"value"}},
          {"kind":"data","from":{"node":"await","port":"value"},"to":{"node":"calculate","port":"a"}},
          {"kind":"data","from":{"node":"calculate","port":"value"},"to":{"node":"send","port":"value"}},
          {"kind":"control","from":{"node":"send","port":"next"},"to":{"node":"sent","port":"in"}},
          {"kind":"data","from":{"node":"send","port":"ok"},"to":{"node":"sent","port":"condition"}},
          {"kind":"control","from":{"node":"sent","port":"true"},"to":{"node":"result","port":"in"}},
          {"kind":"control","from":{"node":"sent","port":"false"},"to":{"node":"send_error","port":"in"}},
          {"kind":"data","from":{"node":"calculate","port":"value"},"to":{"node":"result","port":"value"}},
          {"kind":"data","from":{"node":"send","port":"error"},"to":{"node":"send_error","port":"value"}}
        ]
      }
    },
    {
      "id":"C","label":"Add one",
      "workflow":{
        "version":1,"name":"Add one","entry":"await",
        "nodes":[
          {"id":"await","block":"await_message","inputs":{"source":"B","channel":"b_to_c","timeout_ms":8000}},
          {"id":"received","block":"if","inputs":{}},
          {"id":"calculate","block":"add","inputs":{"b":1}},
          {"id":"send","block":"send_message","inputs":{"destination":"A","channel":"c_to_a","timeout_ms":5000}},
          {"id":"sent","block":"if","inputs":{}},
          {"id":"result","block":"emit","inputs":{"name":"sent_value"}},
          {"id":"send_error","block":"emit","inputs":{"name":"send_error"}},
          {"id":"receive_error","block":"emit","inputs":{"name":"receive_error"}}
        ],
        "edges":[
          {"kind":"control","from":{"node":"await","port":"next"},"to":{"node":"received","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"ok"},"to":{"node":"received","port":"condition"}},
          {"kind":"control","from":{"node":"received","port":"true"},"to":{"node":"send","port":"in"}},
          {"kind":"control","from":{"node":"received","port":"false"},"to":{"node":"receive_error","port":"in"}},
          {"kind":"data","from":{"node":"await","port":"error"},"to":{"node":"receive_error","port":"value"}},
          {"kind":"data","from":{"node":"await","port":"value"},"to":{"node":"calculate","port":"a"}},
          {"kind":"data","from":{"node":"calculate","port":"value"},"to":{"node":"send","port":"value"}},
          {"kind":"control","from":{"node":"send","port":"next"},"to":{"node":"sent","port":"in"}},
          {"kind":"data","from":{"node":"send","port":"ok"},"to":{"node":"sent","port":"condition"}},
          {"kind":"control","from":{"node":"sent","port":"true"},"to":{"node":"result","port":"in"}},
          {"kind":"control","from":{"node":"sent","port":"false"},"to":{"node":"send_error","port":"in"}},
          {"kind":"data","from":{"node":"calculate","port":"value"},"to":{"node":"result","port":"value"}},
          {"kind":"data","from":{"node":"send","port":"error"},"to":{"node":"send_error","port":"value"}}
        ]
      }
    }
  ],
  "channels":[
    {"id":"a_to_b","from":"A","to":"B","type":"number"},
    {"id":"b_to_c","from":"B","to":"C","type":"number"},
    {"id":"c_to_a","from":"C","to":"A","type":"number"}
  ]
}
