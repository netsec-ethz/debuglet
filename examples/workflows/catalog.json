  {
    "id": "udp_exchange",
    "label": "UDP exchange",
    "category": "Network",
    "description": "Send one datagram to host:port and wait for one response. Payload encoding is text or base64; response_base64 preserves exact bytes. Maximum response is 8191 bytes; larger replies are marked truncated.",
    "pure": false,
    "inputs": [
      {
        "name": "target",
        "type": "string",
        "required": true
      },
      {
        "name": "payload",
        "type": "string",
        "default": ""
      },
