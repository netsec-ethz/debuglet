      },
      {
        "name": "duration_ms",
        "type": "number"
      }
    ],
    "control_outputs": [
      "next"
    ]
  },
  {
    "id": "ping",
    "label": "Ping",
    "category": "Network",
    "description": "Send up to ten ICMPv4 echo requests. rtts_ms contains successful replies; loss is a percentage.",
    "pure": false,
    "inputs": [
      {
        "name": "target",
        "type": "string",
        "required": true
      },
      {
        "name": "count",
        "type": "number",
        "default": 3
      },
      {
        "name": "timeout_ms",
        "type": "number",
        "default": 2000
      }
    ],
    "outputs": [
      {
        "name": "ok",
        "type": "boolean"
      },
      {
        "name": "error",
        "type": "string"
      },
      {
        "name": "rtts_ms",
        "type": "numbers"
      },
      {
        "name": "sent",
        "type": "number"
      },
      {
        "name": "received",
        "type": "number"
      },
      {
        "name": "loss",
        "type": "number"
      }
    ],
    "control_outputs": [
      "next"
    ]
  },
