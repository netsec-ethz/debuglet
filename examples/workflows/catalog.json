[
  {
    "id": "http",
    "label": "HTTP request",
    "category": "Network",
    "description": "Send one HTTP request. ok describes transport completion; compare status to choose an HTTP success policy. Redirects are returned, not followed.",
    "pure": false,
    "inputs": [
      {
        "name": "url",
        "type": "string",
        "required": true
      },
      {
        "name": "method",
        "type": "string",
        "default": "GET"
      },
      {
        "name": "timeout_ms",
        "type": "number",
        "default": 2000
      }
    ],
    "outputs": [
      {
        "name": "ok",
        "type": "boolean"
      },
      {
        "name": "error",
        "type": "string"
      },
      {
        "name": "status",
        "type": "number"
      },
      {
        "name": "body",
        "type": "string"
      },
      {
        "name": "duration_ms",
        "type": "number"
      }
    ],
    "control_outputs": [
      "next"
    ]
  },
  {
    "id": "tcp_connect",
