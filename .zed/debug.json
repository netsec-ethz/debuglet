// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug Executor",
    "adapter": "Delve",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/cmd/executor/main.go",
    "request": "launch",
    "args": ["-config", "local/configs/executor.toml"],
  },
  {
    "label": "Debug Dispatcher",
    "adapter": "Delve",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/cmd/dispatcher/main.go",
    "request": "launch",
    "args": ["-config", "local/configs/dispatcher.toml"],
  },
]
