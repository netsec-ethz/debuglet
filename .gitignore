# Key material, certificates and packet captures are generated or recorded
# locally and never committed. Tests issue certificates at runtime
# (internal/testtls).
*.crt
*.key
*.pem
*.der
*.p12
*.pfx
*.csr
*.srl
*.jks
*.pcap
*.pcapng
*.cap
# A root .env holds local secrets. Other *.env files are tracked on purpose
# (deploy/ci/images.env, deploy/provisioner.env); deployment secrets live in
# the ignored deploy/ansible/secrets/.
/.env
# Local dev TLS material predating the convention above: these files have
# no extension, so *.crt / *.key never matched them and they ended up
# tracked. `make generate-certs` writes server.* / client.* instead.
local/configs/*/cert
local/configs/*/key

# binaries
debuglet-executor*
debuglet-dispatcher*
# The reference service units under deploy/systemd are source files whose
# names start with the daemon names above; keep them out of that rule.
!/deploy/systemd/debuglet-dispatcher-*.service
!/deploy/systemd/debuglet-executor-*.service
# Object files are build output. The generated eBPF objects are the only ones
# committed; bpf2go writes them next to their Go bindings.
*.o
!/internal/executor/*/ebpf/*_bpfel.o
/dispatcher
/executor
__debug*

# The project-relative Go module/build caches CI caches between runs.
/.cache
/.ci

# Python env
.venv

.testCoverage.txt
engine.test
benchmarks

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor leftovers
*.swp
*.swo
*.swn
*~
.*.un~

# Python generated files
.mypy_cache/
__pycache__
*.pyc
.venv

# Local assistant and tool-runtime state.
/.claude/
/deploy/.mise/

.data

# Real Ansible inventory identifies private infrastructure (dispatcher
# address, executor hostnames, SSH usernames). Copy hosts.yml.example to
# hosts.yml (prod) / hosts.dev.yml.example to hosts.dev.yml (dev) locally;
# keep real inventory and SSH credentials outside repository history. See
# deploy/ansible/hosts.yml.example and hosts.dev.yml.example.
/deploy/ansible/hosts.yml
/deploy/ansible/hosts.dev.yml
/deploy/ansible/inventory/
