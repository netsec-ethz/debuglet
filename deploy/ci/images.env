# Pinned image inputs shared by scripts/ci-github.sh and verify-image.sh.
# Hosted VM and container boundaries are described in deploy/ci/README.md.
#
# Update process: docs/development/ci-images.md.

# Upstream Go image, pinned by manifest digest. Ordinary lanes run on it
# directly and the tools image is built from it.
DEBUGLET_CI_BASE_IMAGE=golang:1.26.8-bookworm
DEBUGLET_CI_BASE_DIGEST=sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d

# The local and kernel jobs build this image on their disposable hosted VM.
# It adds packages.txt to the pinned base, using the Debian snapshot below.
# Local reproduction prepares the same tag before launching the lane.
DEBUGLET_CI_TOOLS_IMAGE=debuglet-ci-tools:20261002-1
DEBUGLET_CI_DEBIAN_SNAPSHOT=20260918T000000Z

# Toolchain versions recorded in build evidence and checked in every job.
DEBUGLET_CI_GO_VERSION=go1.26.8

# Compiler-free image prepared before the offline installed-payload witness.
DEBUGLET_CI_RUNTIME_IMAGE=debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
