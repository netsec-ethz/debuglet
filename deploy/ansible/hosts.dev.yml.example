# Example Ansible inventory for the Debuglet DEV deployment.
#
# The real hosts.dev.yml is NOT committed to this repo (it identifies
# private infrastructure — dispatcher address, executor hostnames, SSH
# usernames), same as hosts.yml for prod. Copy this file to hosts.dev.yml
# and fill in your real dev hosts:
#
#   cp deploy/ansible/hosts.dev.yml.example deploy/ansible/hosts.dev.yml
#
# In CI, the real hosts.dev.yml is injected as a GitLab CI/CD "Secure File"
# and written to deploy/ansible/hosts.dev.yml before the ansible-playbook
# step runs on the dev branch — see .gitlab-ci.yml. hosts.dev.yml is
# gitignored so it can never be committed by accident.
#
# The dispatcher's host entry is the literal string __DISPATCHER_ADDR__, NOT
# a real address — the deploy job substitutes it (via sed) with the
# DISPATCHER_ADDR_DEV CI/CD variable before running ansible-playbook, so the
# address is entered once, not duplicated between the inventory and the CI
# variable. Keep this placeholder as-is in your real hosts.dev.yml too.

#
# NOTE: a machine can appear in BOTH inventories — ordroid-ethz is an executor
# in prod and in dev. Give it a distinct executor_id per environment (they get
# distinct TLS client certs, and the dispatcher keys its registry on the id).
# Everything else is kept apart automatically: the deploy job layers on
# vars/<env>.yml, and each environment's executor gets its own service user,
# config directory, binary and systemd unit (debuglet-<env>,
# /etc/debuglet/executor-<env>, debuglet-executor-<env>). See
# deploy/ansible/group_vars/executors.yml.

all:
  children:
    # ------------------------------------------------------------------
    # Dispatcher — one machine
    # ------------------------------------------------------------------
    dispatcher:
      hosts:
        __DISPATCHER_ADDR__:
          ansible_user: deploy

    # ------------------------------------------------------------------
    # Executors — all executor machines
    # ------------------------------------------------------------------
    executors:
      children:
        ssh_machines:
          hosts:
            executor-dev-1.example.com:
              ansible_user: deploy
              executor_id: executor-dev-1
