# Example Ansible inventory for the Debuglet DEV deployment.
#
# The real hosts.dev.yml is NOT committed to this repo (it identifies
# private infrastructure — dispatcher address, executor hostnames, SSH
# usernames), same as hosts.yml for prod. Copy this file to hosts.dev.yml
# and fill in your real dev hosts:
#
#   cp deploy/ansible/hosts.dev.yml.example deploy/ansible/hosts.dev.yml
#
# In CI, the real hosts.dev.yml is injected as a GitLab CI/CD "Secure File"
# and written to deploy/ansible/hosts.dev.yml before the ansible-playbook
# step runs on the dev branch — see .gitlab-ci.yml. hosts.dev.yml is
# gitignored so it can never be committed by accident.

all:
  children:
    # ------------------------------------------------------------------
    # Dispatcher — one machine
    # ------------------------------------------------------------------
    dispatcher:
      hosts:
        dispatcher-dev.example.com:
          ansible_user: deploy

    # ------------------------------------------------------------------
    # Executors — all executor machines
    # ------------------------------------------------------------------
    executors:
      children:
        ssh_machines:
          hosts:
            executor-dev-1.example.com:
              ansible_user: deploy
              executor_id: executor-dev-1
