# Example Ansible inventory for a Debuglet dev deployment.
#
# The real hosts.dev.yml is not committed, for the same reason hosts.yml is
# not: it identifies private infrastructure. Copy this file and fill in your
# own dev hosts:
#
#   cp deploy/ansible/hosts.dev.yml.example deploy/ansible/hosts.dev.yml
#
# The dev inventory has its own hosts, so it needs its own pinned host keys.
# Give it its own known-hosts file and select it explicitly:
#
#   cd deploy/ansible && ansible-playbook -i hosts.dev.yml -e @vars/dev.yml site.yml \
#       -e known_hosts_file="{{ playbook_dir }}/known_hosts.dev"
#
# dispatcher_addr and a per-host UUID executor_id are required. The selected
# vars/dev.yml supplies the public API origin; see hosts.yml.example.

#
# A machine can appear in both inventories. Give it a distinct executor_id
# per environment (they get
# distinct TLS client certs, and the dispatcher keys its registry on the id).
# Everything else is kept apart automatically: the selected vars file supplies
# debuglet_env, and each environment's executor gets its own service user,
# config/state directories, package prefix and systemd unit (debuglet-<env>,
# /etc/debuglet/executor-<env>, /var/lib/debuglet/executor-<env>,
# /opt/debuglet/<env>, debuglet-executor-<env>). See
# deploy/ansible/group_vars/executors.yml.

all:
  vars:
    dispatcher_addr: dispatcher-dev.example.com
    # Additional verified TLS names for infrastructure that connects by IP.
    # dispatcher_addr is always included automatically.
    dispatcher_tls_sans:
      - DNS:debuglet-dispatcher-dev

  children:
    # ------------------------------------------------------------------
    # Dispatcher — one machine
    # ------------------------------------------------------------------
    dispatcher:
      hosts:
        dispatcher-dev.example.com:
          ansible_user: deploy

    # ------------------------------------------------------------------
    # Executors — every executor machine
    # ------------------------------------------------------------------
    executors:
      children:
        ssh_machines:
          hosts:
            executor-dev-1.example.com:
              ansible_user: deploy
              executor_id: 1144ad6e-2c14-4e5c-ab72-c05a8e8770f2
