# Copy to secrets/prod/github-oauth.env and secrets/dev/github-oauth.env.
# Keep each real file owner-readable only (chmod 600). The client secret must
# never be committed; the client ID is included here because it is public OAuth
# application metadata, but keeping both values together avoids split setup.
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
