# Dispatcher configuration, rendered by deploy/ansible for a managed host.
# Do not edit it there: the next deployment overwrites it. Change the
# variables in deploy/ansible/group_vars instead.
#
# Profile: authenticated deployment. The local TEST fixture is a different
# profile; see deploy/docker/configs/dispatcher/dispatcher.toml.

[server]
http_port = {{ dispatcher_http_port }}
grpc_port = {{ dispatcher_grpc_port }}
version = "{{ deploy_version }}"

[logging]
log_level = "{{ dispatcher_log_level }}"
json_logs = true

[scheduler]
executor_timeout = {{ dispatcher_executor_timeout }}
scheduler_granularity_ms = {{ dispatcher_scheduler_granularity_ms }}

# The dispatcher serves its own listeners; executors verify this certificate
# against the name they dialled, so it has to carry dispatcher_addr in its
# subjectAltName. deploy/scripts/generate-certs.sh issues it and
# deploy-certs.yml installs it.
[tls]
disable = {{ dispatcher_disable_tls | bool | lower }}
cert_file = "{{ config_dir }}/dispatcher/server.crt"
key_file = "{{ config_dir }}/dispatcher/server.key"
{% if dispatcher_require_client_cert | bool %}
# Client certificates are required, so the authority they are checked against
# is read at startup.
ca_file = "{{ dispatcher_tls_ca_file }}"
require_client_cert = {{ dispatcher_require_client_cert | bool | lower }}
{% endif %}

{% if dispatcher_executor_onboarding_enabled | bool %}
[executor_onboarding]
enabled = true
ca_cert = "{{ config_dir }}/dispatcher/enrollment-ca.crt"
ca_key = "{{ config_dir }}/dispatcher/enrollment-ca.key"
dispatcher_url = {{ dispatcher_executor_onboarding_dispatcher_url | to_json }}
grpc_address = {{ dispatcher_executor_onboarding_grpc_address | to_json }}
yamux_address = {{ dispatcher_executor_onboarding_yamux_address | to_json }}
{% endif %}

[sui]
disabled = {{ dispatcher_sui_disabled | bool | lower }}
network = "{{ dispatcher_sui_network }}"
grpc_endpoint = "{{ dispatcher_sui_grpc_endpoint }}"
graphql_url = "{{ dispatcher_sui_graphql_url }}"
address = "{{ dispatcher_sui_address }}"
payment_registry_id = "{{ dispatcher_sui_payment_registry_id }}"
payment_kit_package = "{{ dispatcher_sui_payment_kit_package }}"
keystore_path = "{{ dispatcher_sui_keystore_path }}"

# Writable state, in the service account's own directory. The daemon opens
# this database and does not create its schema; the role installs one.
[database]
path = "{{ state_dir }}/dispatcher/dispatcher.db"

{# Operator labels, one table per labelled executor in the inventory, keyed by
   its executor_id (see executor_display_* in group_vars/executors.yml). #}
{% for name in groups['executors'] | default([]) | sort %}
{%   set executor = hostvars[name] %}
{%   set labels = {
       'display_name': executor.executor_display_name | default(''),
       'city': executor.executor_display_city | default(''),
       'country': executor.executor_display_country | default(''),
       'network': executor.executor_display_network | default('')} %}
{%   if executor.executor_id is defined and (labels.values() | select | list | length) > 0 %}
# {{ name }}
[executors.{{ executor.executor_id | to_json }}]
{%     for key in ['display_name', 'city', 'country', 'network'] if labels[key] %}
{{ key }} = {{ labels[key] | to_json }}
{%     endfor %}

{%   endif %}
{% endfor %}
[cors]
allowed_origins = {{ dispatcher_cors_allowed_origins | to_json }}

[github_oauth]
enabled = {{ dispatcher_github_oauth_enabled | bool | lower }}
callback_url = "{{ dispatcher_github_oauth_callback_url }}"
success_url = "{{ dispatcher_github_oauth_success_url }}"

[cilogon_oidc]
enabled = {{ dispatcher_cilogon_oidc_enabled | bool | lower }}
issuer = "{{ dispatcher_cilogon_oidc_issuer }}"
callback_url = "{{ dispatcher_cilogon_oidc_callback_url }}"
success_url = "{{ dispatcher_cilogon_oidc_success_url }}"

{% if dispatcher_authentication_public_url | length > 0 %}
[authentication]
public_url = {{ dispatcher_authentication_public_url | to_json }}
device_verification_url = {{ dispatcher_authentication_device_verification_url | to_json }}
{% endif %}
{% if dispatcher_ris_asn_enabled | bool %}

# Executor ASN and announced prefix, looked up in the database the
# debuglet-ris-asn timer rebuilds daily from RIPE RIS. The dispatcher loads a
# replaced file within a minute, without a restart.
[metadata]
asn_database = {{ dispatcher_ris_asn_database | to_json }}
{% endif %}
