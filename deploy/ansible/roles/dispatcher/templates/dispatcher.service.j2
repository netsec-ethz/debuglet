[Unit]
Description=Debuglet Dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ debuglet_user }}
Group={{ debuglet_group }}
{% if dispatcher_github_oauth_enabled | bool %}
EnvironmentFile={{ config_dir }}/dispatcher/github-oauth.env
{% endif %}
ExecStart={{ payload_prefix }}/bin/debuglet-dispatcher \
    -config {{ config_dir }}/dispatcher/dispatcher.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=debuglet-dispatcher

[Install]
WantedBy=multi-user.target
