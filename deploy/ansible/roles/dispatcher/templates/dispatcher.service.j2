[Unit]
Description=Debuglet Dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ debuglet_user }}
Group={{ debuglet_group }}
ExecStart={{ install_prefix }}/bin/debuglet-dispatcher \
    -config {{ config_dir }}/dispatcher/dispatcher.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=debuglet-dispatcher

[Install]
WantedBy=multi-user.target
