[Unit]
Description=Debuglet Executor ({{ executor_id }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ debuglet_user }}
Group={{ debuglet_group }}
ExecStart={{ install_prefix }}/bin/debuglet-executor \
    -config {{ config_dir }}/executor/executor.toml
# Restart on any exit (including code 0). A dropped control stream should always
# bring the executor back; a deliberate `systemctl stop` still stops it.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=debuglet-executor

{% if (executor_enable_bpf | default(true)) and (executor_ambient_caps | default(true)) %}
# systemd hands these to the process at exec (ambient set). On restricted
# environments (some containers/EdgeNet) manipulating the ambient set fails with
# 203/EXEC; set executor_ambient_caps=false there and rely on the binary's file
# capabilities (setcap, applied by the executor role) instead.
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF
{% endif %}

[Install]
WantedBy=multi-user.target
