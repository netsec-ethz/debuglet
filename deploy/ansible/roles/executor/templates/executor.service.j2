[Unit]
Description=Debuglet Executor ({{ executor_id }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ debuglet_user }}
Group={{ debuglet_group }}
ExecStart={{ install_prefix }}/bin/debuglet-executor \
    -config {{ config_dir }}/executor/executor.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=debuglet-executor

{% if executor_enable_bpf | default(true) %}
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF
{% endif %}

[Install]
WantedBy=multi-user.target
