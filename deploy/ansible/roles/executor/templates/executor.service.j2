[Unit]
Description=Debuglet Executor ({{ executor_id }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ executor_user }}
Group={{ executor_group }}
ExecStart={{ executor_binary }} \
    -config {{ executor_config_dir }}/executor.toml
# Restart on any exit (including code 0). A dropped control stream should always
# bring the executor back; a deliberate `systemctl stop` still stops it.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ executor_service }}

{% if (executor_enable_bpf | default(true)) and (executor_ambient_caps | default(false)) %}
# systemd hands these to the process at exec (ambient set). On restricted
# environments (some containers/EdgeNet) manipulating the ambient set fails with
# 203/EXEC; set executor_ambient_caps=false there and rely on the binary's file
# capabilities (setcap, applied by the executor role) instead. The set is
# executor_capabilities in group_vars/executors.yml.
AmbientCapabilities={{ executor_capabilities | map('upper') | join(' ') }}
CapabilityBoundingSet={{ executor_capabilities | map('upper') | join(' ') }}
{% endif %}
{% if (executor_enable_bpf | default(true)) and ansible_kernel is defined and ansible_kernel is version('5.11', '<') %}
# Before Linux 5.11 BPF maps count against RLIMIT_MEMLOCK. Lifting it here
# spares the executor CAP_SYS_RESOURCE (see executor_capabilities).
LimitMEMLOCK=infinity
{% endif %}

[Install]
WantedBy=multi-user.target
