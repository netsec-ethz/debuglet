[identity]
executor_id = "{{ executor_id }}"
version = "{{ executor_version }}"

[dispatcher]
addr = "{{ dispatcher_addr }}:{{ dispatcher_grpc_port }}"
yamux_addr = "{{ dispatcher_addr }}:{{ dispatcher_http_port }}"

[tls]
disable = {{ executor_disable_tls | lower }}

[resources]
capacity = {{ executor_capacity }}
max_debuglets = {{ executor_max_debuglets }}

[tesla]
seed = "{{ executor_tesla_seed }}"
delay = {{ tesla_delay }}
chain_length = {{ tesla_chain_length }}

[network]
# Egress interface the eBPF TC tagger attaches to. Packet attribution is only
# applied to traffic leaving this interface, so leaving it empty disables
# tagging entirely (see executor_interface in group_vars/executors.yml).
interface = "{{ executor_interface }}"
public_host = "{{ executor_public_host }}"
public_ports = "{{ executor_public_ports }}"

[logging]
log_level = "{{ executor_log_level }}"

[database]
path = "{{ config_dir }}/executor/executor.db"

[credentials]
ca_cert = "{{ config_dir }}/executor/ca.crt"
client_cert = "{{ config_dir }}/executor/client.crt"
client_key = "{{ config_dir }}/executor/client.key"
