# Copy to secrets/prod/cilogon_oidc.env (and secrets/dev/cilogon_oidc.env when
# dev enables CILogon). Keep each real file owner-readable only (chmod 600). The
# client secret must never be committed; the client ID is public metadata, kept
# beside it to avoid split setup. The CILogon client must list exactly
# https://<dispatcher_base_url>/api/auth/cilogon/callback.
CILOGON_CLIENT_ID=cilogon:/client_id/replace-with-client-id
CILOGON_CLIENT_SECRET=replace-with-cilogon-client-secret
