# Example Ansible inventory for the Debuglet deployment.
#
# The real hosts.yml is NOT committed to this repo (it identifies private
# infrastructure — dispatcher address, executor hostnames, SSH usernames).
# Copy this file to hosts.yml and fill in your real hosts:
#
#   cp deploy/ansible/hosts.yml.example deploy/ansible/hosts.yml
#
# In CI, the real hosts.yml is injected as a GitLab CI/CD "Secure File" (or a
# protected file variable) and written to deploy/ansible/hosts.yml before the
# ansible-playbook step runs — see .gitlab-ci.yml. hosts.yml is gitignored so
# it can never be committed by accident.

all:
  children:
    # ------------------------------------------------------------------
    # Dispatcher — one machine
    # ------------------------------------------------------------------
    dispatcher:
      hosts:
        dispatcher.example.com:
          ansible_user: deploy

    # ------------------------------------------------------------------
    # Executors — all executor machines
    # ------------------------------------------------------------------
    executors:
      children:
        # Regular SSH-accessible machines
        ssh_machines:
          hosts:
            executor1.example.com:
              ansible_user: deploy
              executor_id: executor-1

            # A restricted host (container / limited kernel capabilities):
            # executor2.example.com:
            #   ansible_user: deploy
            #   executor_id: executor-2
            #   executor_enable_bpf: true
            #   executor_ambient_caps: false   # see group_vars/executors.yml

        # PlanetLab / EdgeNet nodes
        # SSH user is typically your slice name (e.g. eth_debuglet).
        # edgenet:
        #   vars:
        #     ansible_user: eth_debuglet     # <-- update to your slice name
        #   hosts:
        #     planetlab1.example.eu:
        #       executor_id: executor-pl1
        #
        #     planetlab2.example.eu:
        #       executor_id: executor-pl2
