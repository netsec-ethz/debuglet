# Pinned provisioner inputs.
#
# The provisioner is the machine that runs the Ansible playbooks. It is
# identified separately from the application: a deployment records both, and
# neither is inferred from the other. The application's identity comes from
# the release payload (deploy/dist/release.json, written by
# deploy/scripts/build-linux.sh); the provisioner's identity is this file.
#
# deploy/docker/provisioner.Dockerfile builds the image from these values and
# stamps them into /etc/debuglet/provisioner.json inside it.
# deploy/ansible/preflight-provisioner.yml compares that record and the
# installed versions against this file before any deployment task runs, so a
# provisioner built from other inputs, or a manifest edited after the image
# was built, stops the deployment before it changes a host.
#
# Update process: change the pinned values, rebuild the image with
# deploy/test/provisioner-check.sh, and commit the two together.

# Upstream Python image, pinned by manifest digest. The dependency digests
# below are resolved inside exactly this image: its interpreter and platform
# decide which wheels the pinned requirements name.
DEBUGLET_PROVISIONER_BASE_IMAGE=python:3.13-slim
DEBUGLET_PROVISIONER_BASE_DIGEST=sha256:b04b5d7233d2ad9c379e22ea8927cd1378cd15c60d4ef876c065b25ea8fb3bf3

# Locally built image. The project has no container registry, so this
# reference is a tag resolved on the machine that built it and the build
# inputs are pinned instead: the base digest above and the digests below.
DEBUGLET_PROVISIONER_IMAGE=debuglet-provisioner:20260915-2

# Ansible and the collections the roles use. The versions are the ones the
# pinned requirements install; the preflight refuses anything else.
DEBUGLET_ANSIBLE_CORE_VERSION=2.21.4
DEBUGLET_COLLECTION_COMMUNITY_GENERAL_VERSION=13.4.0
DEBUGLET_COLLECTION_COMMUNITY_GENERAL_SHA256=efd1c0b5dc6f89b9667e4bd77f2426c30545861910dba188593871095ede1804
DEBUGLET_COLLECTION_LIBRARY_INVENTORY_FILTERING_VERSION=1.1.5
DEBUGLET_COLLECTION_LIBRARY_INVENTORY_FILTERING_SHA256=cbb9e86c5b1720df21e940cedcd2f3e1226c38262623e090a883712610733851

# goose, which `make deploy-seed-db` runs to write the schema-only databases
# the roles install on every host. It is pinned by the digest of the release
# binary the image installs, so the schema a deployment ships does not depend
# on what the operator has installed locally.
DEBUGLET_GOOSE_VERSION=3.27.3
DEBUGLET_GOOSE_SHA256=ca18112e2438b3ad608af9a5938beafd01fa36a4a19a3edbe4f29226ca5c8533

# Digests of the two dependency manifests themselves. A manifest edited after
# the image was built no longer matches the record inside it, and the
# preflight stops the deployment instead of running with dependencies nobody
# installed.
DEBUGLET_PROVISIONER_REQUIREMENTS_SHA256=b59a3c7667c9ba847af95230579339d0c5bf4920a57d6627c815c6210a395f40
DEBUGLET_PROVISIONER_COLLECTIONS_SHA256=de140fc91f7f5d42a7daefe8ec3366c2e7387cca894cb3a57c570415750047a0
